generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  image        String?
  posts        Post[]
  comments     Comment[]
  instituicoes Instituicao[] @relation("UserInstituicoes")

  @@map("user")
}

model Post {
  id          Int    @id @default(autoincrement())
  title       String @unique
  description String
  authorId    Int

  author User @relation(fields: [authorId], references: [id])

  comments    Comment[]
  ingredients IngredientsOnPosts[]

  @@map("post")
}

model Instituicao {
  id          Int    @id @default(autoincrement())
  name        String
  latitude    String
  longitude   String
  createdById Int
  createdBy   User   @relation("UserInstituicoes", fields: [createdById], references: [id])

  @@map("instituicao")
}

model Comment {
  id          Int    @id @default(autoincrement())
  description String
  authorId    Int

  author User @relation(fields: [authorId], references: [id])

  postId Int

  post Post @relation(fields: [postId], references: [id])

  @@map("comment")
}

model Ingredient {
  id    Int                  @id @default(autoincrement())
  name  String
  posts IngredientsOnPosts[]

  deleted_at DateTime?

  @@map("ingredients")
}

model IngredientsOnPosts {
  id           Int        @id @default(autoincrement())
  postId       Int?
  ingredientId Int?

  post       Post?       @relation(fields: [postId], references: [id])
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])

  @@map("ingredients_recipe_posts")
}
